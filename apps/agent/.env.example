# Which merchant to buy from
MERCHANT_BASE_URL=http://localhost:3100
# Max USDC the agent will spend on any single call
MAX_USDC_PER_CALL=1

# --- Signer selection ---
# "privy" (default if PRIVY_APP_ID set) or "local"
SIGNER_MODE=

# Local key mode (fast E2E testing) — a funded Base-Sepolia test key
PRIVATE_KEY=

# Privy mode (hackathon) — from the Privy dashboard
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Required if your Privy app has an authorization keypair registered
PRIVY_AUTHORIZATION_KEY=
# Set after first run to reuse the same server wallet (else a new one is created)
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
