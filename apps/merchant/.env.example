# Data source: "apollo" proxies the real Apollo API; anything else (or a missing
# APOLLO_API_KEY) falls back to the mock DB.
DATA_PROVIDER=mock
APOLLO_API_KEY=

# --- x402 payment layer (used from M3 onward) ---
# The wallet that receives USDC payments (your merchant address).
MERCHANT_ADDRESS=
# Network + facilitator. Base Sepolia testnet uses the free public facilitator.
NETWORK=base-sepolia
FACILITATOR_URL=https://x402.org/facilitator
# Set to "true" to actually enforce payment. Leave unset/false to run open (dev).
X402_ENABLED=false

# --- zkTLS delivery attestation (optional; merchant proves it fetched good Apollo data) ---
# Off by default. When true, /people/enrich attaches a Reclaim proof as `provenance`.
# Requires @reclaimprotocol/zk-fetch + js-sdk installed and a Reclaim app id/secret.
# NOTE: currently spends a second Apollo enrich credit per attested call.
ATTEST_ENABLED=false
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
